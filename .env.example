# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public HTTPS origin of the site, without a trailing slash.
# Used for canonical URLs, Open Graph image URLs, sitemap.xml and robots.txt.
# On Vercel this falls back to the production domain automatically when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Web3Forms access key for the contact form (https://web3forms.com).
# Messages go to the email address the key was created for.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
