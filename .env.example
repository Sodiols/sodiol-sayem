# Required at build time: canonical HTTPS origin, no trailing path.
NEXT_PUBLIC_SITE_URL=
# Public identifier from your verified Web3Forms form.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# Optional: obtain the actual G-... ID from your GA4 web data stream.
# Without it, the Google tag remains disabled even after visitor opt-in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
